# Copy to .env and fill in. Never commit the real .env file.
#
# The Telegram bot token used in Section 6 (Real Alerting) is NOT a .env
# value -- it lives in AWS Secrets Manager and is fetched by the Lambda
# at invoke time (see infra/environments/dev/telegram.tf and
# notifications/telegram/handler.py). There is no local-file path that
# should ever hold the real token; don't add one back here.

# Email notifications used in Section 6 (Real Alerting)
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
