#!/usr/bin/env bash
# Tracked pre-commit hook (review finding F5). .git/hooks/ isn't versioned, so this
# lives here instead -- run once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# --staged, not --full: history-scanning is one-way (once something's
# committed, it stays flagged forever), so gating every future commit on
# it would make the hook permanently useless the first time anything
# trips it. Run `scripts/secret-scan.py --full` manually for audits.
python3 scripts/secret-scan.py --staged
